[
  {
    "id": "jkanime_dynamic",
    "name": "Jkanime Dinámico",
    "baseUrl": "https://jkanime.net",
    "region": "LAT",
    "type": "ANIME",
    "home": [
      {
        "title": "EPISODIOS RECIENTES",
        "path": "/",
        "selector": "#animes .card",
        "itemTitle": "h5.card-title",
        "itemUrl": "a->attr:href",
        "itemImage": "img->attr:data-animepic"
      },
      {
        "title": "TRENDING",
        "path": "/",
        "selector": ".trending__anime .item",
        "itemTitle": "h5",
        "itemUrl": "a->attr:href",
        "itemImage": "img->attr:src"
      }
    ],
    "search": {
      "path": "/buscar/{query}/",
      "selector": ".anime__item, .card",
      "itemTitle": "h5",
      "itemUrl": "a->attr:href",
      "itemImage": "img->attr:src"
    },
    "details": {
      "description": ".anime_info p.scroll",
      "episodesSelector": ".anime__pagination option",
      "episodeTitle": "text",
      "episodeUrl": "attr:value"
    }
  }
]
