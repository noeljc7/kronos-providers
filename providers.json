[
  {
    "id": "jkanime_dynamic",
    "name": "Jkanime Dinámico",
    "baseUrl": "https://jkanime.net",
    "region": "LAT",
    "type": "ANIME",
    "home": [
      {
        "title": "ANIMES RECIENTES",
        "path": "/",
        "selector": "#animes .card",
        "itemTitle": "h5.card-title",
        "itemUrl": "a->attr:href",
        "itemImage": "img->attr:data-animepic"
      },
      {
        "title": "DONGHUAS",
        "path": "/",
        "selector": "#donghuas .card",
        "itemTitle": "h5.card-title",
        "itemUrl": "a->attr:href",
        "itemImage": "img->attr:data-animepic"
      }
    ],
    "search": {
      "path": "/buscar/{query}/",
      "selector": ".anime__item",
      "itemTitle": "h5 a",
      "itemUrl": "h5 a->attr:href",
      "itemImage": ".set-bg->attr:data-setbg"
    },
    "details": {
      "description": ".anime_info p.scroll",
      "totalEpisodesSelector": "ajax:#guardar-anime->attr:data-anime",
      "episodeTitle": "Capítulo {n}",
      "episodeUrl": "/{n}/"
    },
    "videos": {
      "scriptRegex": "var servers = (\\[.*?\\]);",
      "serverName": "server",
      "serverUrl": "remote->base64"
    }
  },
  {
    "id": "animeflv_dynamic",
    "name": "AnimeFLV Dinámico",
    "baseUrl": "https://www3.animeflv.net",
    "region": "LAT",
    "type": "ANIME",
    "home": [
      {
        "title": "ÚLTIMOS EPISODIOS",
        "path": "/",
        "selector": ".ListEpisodios li",
        "itemTitle": "strong.Title",
        "itemUrl": "a->attr:href",
        "itemImage": "img->attr:src"
      }
    ],
    "search": {
      "path": "/browse?q={query}",
      "selector": ".ListAnimes .Anime",
      "itemTitle": ".Title",
      "itemUrl": "a->attr:href",
      "itemImage": "img->attr:src"
    },
    "details": {
      "description": ".Sinop",
      "episodesSelector": "ul.ListCaps li",
      "episodeTitle": "text",
      "episodeUrl": "a->attr:href"
    },
    "videos": {
      "selector": ".Table .Button.Sm.Ln-YouTube",
      "serverName": "text",
      "serverUrl": "attr:href"
    }
  }
]
